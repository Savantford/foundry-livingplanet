<section>
  {{log this}}
  {{!-- Entry List of Scenes --}}
  <details>
    <summary>{{entry.name}}'s Scenes</summary>

    <ol class="scenes-list">
      {{#each scenes as |scene|}}
        <li {{#if (eq scene.id @root.scene.id)}}class="active"{{/if}}>
          {{{ scene.link }}}
          ({{localize (lookup @root.sceneTypes scene.type)}})
        </li>
      {{/each}}
    </ol>
  </details>

  <div class="cards">
    {{!-- Expedition --}}
    <div class="card expedition">
      {{#with expedition}}
      <h2 class="scene-title">
        {{!-- Name --}}
        {{ name }}
      </h2>

      {{!-- Objectives --}}
      <fieldset class="obstacles mt-1">
        <legend class="flexrow gap-5">
          {{localize "LP.Expedition.Objective.Plural"}}
        </legend>

        <ol>
          {{#each system.objectives as |objective idx|}}
          <li class="objective {{#if objective.done}}done{{/if}}">
            <input type="checkbox" name="system.objectives.{{idx}}.done" {{checked objective.done}}>
        
            <span>
              <span>{{objective.text}}</span>

              <span>({{#if (eq objective.type "main")}}{{localize "LP.Truth.Hard"}}{{else}}{{localize "LP.Truth.Soft"}}{{/if}})</span>
            </span>
          </li>
          {{/each}}
        </ol>
      </fieldset>
      {{/with}}
    </div>

    {{!-- Current Scene --}}
    <div class="card scene">
      {{#with scene}}
      <h2 class="scene-title">
        {{!-- Name --}}
        {{ name }}
      </h2>

      {{!-- Scene Type --}}
      <span class="scene-type">
        {{localize (lookup @root.sceneTypeLabels system.sceneType)}},
        {{@root.sysFields.complexity.label}} {{system.complexity}}
      </span>
      
      {{!-- Scene Objective --}}
      <div class="scene-objective">{{ system.objective }}</div>

      {{!-- Obstacles --}}
      <fieldset class="obstacles mt-1">
        <legend class="flexrow gap-5">
          {{localize "LP.Scene.Obstacle.Plural"}}
        </legend>

        <ol>
          {{#each system.obstacles as |obstacle idx|}}
          <li class="obstacle {{#if obstacle.done}}done{{/if}}">
            <input type="checkbox" name="system.obstacles.{{idx}}.done" {{checked obstacle.done}}>
        
            <span>
              <span>{{obstacle.text}}</span>

              <span>({{#if (gt obstacle.cost 1)}}{{localize "LP.Truth.Hard"}}{{else}}{{localize "LP.Truth.Soft"}}{{/if}})</span>
            </span>
          </li>
          {{/each}}
        </ol>
      </fieldset>
      {{/with}}
    </div>
  </div>
</section>