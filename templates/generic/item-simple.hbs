<li class="item">
  <div class="item-name">
    <span>
      {{!-- Name --}}
      <label>{{item.name}}</label>

      <span class="buttons">

        {{!-- Edit Button --}}
        <a class="item-button" data-action="itemEdit" data-item-id="{{item._id}}" title="{{localize (concat "
          WW.Item.Edit." item.type)}}">
          <i class="fa-solid fa-edit"></i></a>

        {{!-- Delete Button --}}
        <a class="item-button" data-action="itemRemove" data-item-id="{{item._id}}" title="{{localize (concat "WW.Item.Delete." item.type)}}">
          <i class="fa-solid fa-trash"></i></a>

      </span>
    </span>

    {{!-- Source --}}
    <span class="float-right">
      {{#if (eq item.system.source "frame")}}{{localize "LP.Frame"}}
      {{else if (eq item.system.source "modification")}}{{localize "LP.Asset.Modification"}}
      {{else if (eq item.system.source "knowledge")}}{{localize "LP.Asset.Knowledge"}}
      {{else if (eq item.system.source "equipment")}}{{localize "LP.Asset.Equipment"}}
      {{/if}}
    </span>
  </div>
</li>