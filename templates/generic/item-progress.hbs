<li class="item flexrow" data-item-id="{{item._id}}">
  <div class="flexcol" style="width: 100%;">
    <div class="item-name">
      {{!-- Name --}}
      <label>{{item.name}}</label>

      <span class="buttons">

        {{!-- Edit Button --}}
        <a class="item-button" data-action="itemEdit" data-item-id="{{item._id}}" title="{{localize (concat "
          WW.Item.Edit." item.type)}}">
          <i class="fa-solid fa-edit"></i></a>

        {{!-- Delete Button --}}
        <a class="item-button" data-action="itemRemove" data-item-id="{{item._id}}" title="{{localize (concat "
          WW.Item.Delete." item.type)}}">
          <i class="fa-solid fa-trash"></i></a>

      </span>
    </div>

    <div class="nowrap">
      {{!-- Type --}}
      {{#if (eq item.system.type "cultural")}}{{localize "LP.Connection.Cultural"}}
      {{else if (eq item.system.type "regional")}}{{localize "LP.Connection.Regional"}}
      {{else}}{{localize "LP.Connection.Personal"}}
      {{/if}}

      •

      {{!-- Level --}}
      {{#if (eq item.system.progress.max 8)}}{{localize "LP.Connection.Essential"}}
      {{else if (eq item.system.progress.max 6)}}{{localize "LP.Connection.Crucial"}}
      {{else if (eq item.system.progress.max 4)}}{{localize "LP.Connection.Strong"}}
      {{else if (eq item.system.progress.max 3)}}{{localize "LP.Connection.Relevant"}}
      {{else}}{{localize "LP.Connection.Weak"}}
      {{/if}}

      {{!-- Degree --}}
      {{#if (eq item.system.progress.max 3)}}{{localize "LP.Strength.Amazing"}}
      {{else if (eq item.system.progress.max 2)}}{{localize "LP.Strength.VeryGood"}}
      {{else if (eq item.system.progress.max 1)}}{{localize "LP.Strength.Good"}}
      {{else if (eq item.system.progress.max -1)}}{{localize "LP.Strength.Bad"}}
      {{else if (eq item.system.progress.max -2)}}{{localize "LP.Strength.VeryBad"}}
      {{else if (eq item.system.progress.max -3)}}{{localize "LP.Strength.Terrible"}}
      {{/if}}

      {{!-- Difficulty --}}
      {{#if (eq item.system.progress.max 8)}}{{localize "LP.Progress.Challenge.Epic"}}
      {{else if (eq item.system.progress.max 6)}}{{localize "LP.Progress.Challenge.Hard"}}
      {{else if (eq item.system.progress.max 4)}}{{localize "LP.Progress.Challenge.Troublesome"}}
      {{else if (eq item.system.progress.max 3)}}{{localize "LP.Progress.Challenge.Significant"}}
      {{else}}{{localize "LP.Progress.Challenge.Easy"}}
      {{/if}}
    </div>
  </div>

  {{!-- Impatience Clock --}}
  <div class="progress-container">
    {{> clock arr=item.progressArr data=item.system.progress}}
  </div>
</li>