<div class="progress-clock" style="--segments: {{data.max}}" data-segments="{{data.max}}" title="{{localize "LP.Progress.Hint"}}">
    {{!-- Foreground --}}
    <div class="foreground"></div>

    {{!-- Hidden Inputs --}}
    {{#each arr as |obj key|}}
        <input class="pie slice{{obj.id}}" type="radio" value="{{obj.id}}" data-action="updateProgress" style="--index: {{obj.id}}" {{checked obj.checked}} />

        <div class="divider" style="--index: {{obj.id}}"></div>
    {{/each}}
</div>