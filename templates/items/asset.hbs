<form class="{{cssClass}} item-sheet" autocomplete="off">

  {{!-- Header --}}
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}"/>

    <h1 class="charname"><input name="name" type="text" value="{{item.name}}" placeholder="{{localize "WW.ItemName"}}"/></h1>
  </header>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    <div>
      <label>{{localize "LP.Asset.Source"}}</label>

      <select name="system.source">
        {{selectOptions assetSources selected=system.source localize=true}} {{!--nameAttr="key" labelAttr="label"--}}
      </select>
    </div>
  
  </section>

</form>