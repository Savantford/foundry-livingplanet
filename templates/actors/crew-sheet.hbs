<section class="sheet-body flexcol gap-10">
  {{!-- Sheet Header --}}
  <header class="sheet-header crew-header">
    <h1 class="charname"><input name="name" type="text" value="{{actor.name}}" placeholder="{{localize "LP.ActorName"}}" /></h1>

    {{!-- Profile Image --}}
    <img class="profile-img" src="{{actor.img}}" data-action="editImage" data-edit="img" title="{{actor.name}}"
      height="100" width="100" />
  </header>

  {{!-- Experience --}}
  <div class="stat-inline">
    {{formGroup sysFields.preparation name="system.preparation" value=system.preparation}}

    ({{localize (concat "LP.Crew.Preparation.Lv" system.preparation)}})
  </div>

  <div class="stat">
    <label>{{localize "LP.Crew.Members"}}</label>
    
    {{#each members as |member id|}}
      {{{ member }}}
    {{/each}}
  </div>

  {{!-- Lists --}}
  <div class="flexrow gap-10">
    {{!-- Goals --}}
    <fieldset class="stat stat-box">
      <legend class="flexrow flex-group-left">
        {{localize "LP.Goal.Plural"}}

        {{!-- Goal Create Button --}}
        <button class="mini ml-1" title="{{localize "LP.Goal.Create"}}" data-action="goalCreate">
          <i class="fa-solid fa-plus"></i>
        </button>
      </legend>

      <ol class="item-list">
        {{#each goals as |goal idx|}}
          {{goal}}
          <button class="mini" title="{{localize "LP.Goal.Remove"}}" data-action="goalremove" data-index="idx">
            <i class="fa-solid fa-trash"></i>
          </button>
        {{/each}}
      </ol>
    </fieldset>

    {{!-- Connections --}}
    <fieldset class="stat stat-box">
      <legend class="flexrow flex-group-left">
        {{localize "LP.Connection.Plural"}}

        {{!-- Connection Create Button --}}
        <button class="mini ml-1" title="{{localize "LP.Connection.Create"}}" data-action="itemCreate" data-type="connection">
          <i class="fa-solid fa-plus"></i>
        </button>
      </legend>

      <ol class="item-list connections">
        {{#each connections as |item id|}}
          {{> itemProgress item=item id=id}}
        {{/each}}
      </ol>
    </fieldset>
  </div>

  {{!-- Assets --}}
  <div class="flexrow gap-10">
    <fieldset class="stat stat-box">
      <legend class="flexrow flex-group-left">
        {{localize "LP.Asset.Plural"}}

        {{!-- Asset Create Button --}}
        <button class="mini ml-1" title="{{localize "LP.Asset.Create"}}" data-action="itemCreate" data-type="asset">
          <i class="fa-solid fa-plus"></i>
        </button>
      </legend>

      <ol class="item-list assets">
        {{#each assets as |item id|}}
          {{> itemSimple item=item id=id}}
        {{/each}}
      </ol>

    </fieldset>
  </div>

  {{!-- Timeline --}}
  <fieldset class="timeline stat stat-box">
    <legend class="flexrow flex-group-left">
      {{localize "LP.Crew.Timeline.Label"}}

      {{!-- Timeline Entry Create Button --}}
      <button class="mini ml-1" title="{{localize "LP.Timeline.Create"}}" data-action="timelineCreate">
        <i class="fa-solid fa-plus"></i>
      </button>
    </legend>

    <ol class="timeline-entries">
      <li class="timeline-entry timeline-header">
        <div class="cycle">{{localize "LP.Crew.Timeline.Cycle"}}</div>
        <div class="expedition">{{localize "LP.Crew.Timeline.Expedition"}}</div>
        <div class="base-event">{{localize "LP.Crew.Timeline.BaseEvent"}}</div>
        <div class="local-event">{{localize "LP.Crew.Timeline.LocalEvent"}}</div>
        <div class="other">{{localize "LP.Crew.Timeline.Other"}}</div>
      </li>

      {{#each system.timeline as |entry idx|}}
        {{> "systems/livingplanet/templates/actors/parts/timeline-entry.hbs" entry=entry idx=idx}}
      {{/each}}
    </ol>
  </fieldset>
</section>