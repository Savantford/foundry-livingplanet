<section class="sheet-body">
  {{!-- Sheet Header --}}
  <header class="sheet-header character-header">
    {{!-- Name --}}
    <h1 class="charname">
      <input name="name" type="text" value="{{ actor.name }}" placeholder="{{localize "LP.Deviant.Name"}}" />
    </h1>

    {{!-- Image / Radar Box --}}
    <div class="image-box">
      {{!-- Profile Image --}}
      <img class="profile-img" src="{{ actor.img }}" data-edit="img" title="{{ actor.name }}" height="100" width="100">
      
      {{!-- Radar Chart Block --}}
      <div class="radar-chart-block">
        <div class="labels">
          {{localize "LP.Attributes.Power"}}
          <input type="number" name="system.attributes.power.current" value="{{system.attributes.power.current}}" min="-2"
            max="2">
          <i class="fa-solid {{#if (lt system.attributes.power.current 0)}}fa-down{{else}}fa-up{{/if}}"></i>
        </div>
      
        {{!-- Radar Chart --}}
        <div class="radar-chart">
          <div class="wrapper">
            <div class="grids polygons" style="--grid-line-rgb: var(--highlight-title-rbg)">
              <div></div>
            </div>
            <div class="grids polygons">
              <div></div>
            </div>
            <div class="grids polygons" style="--grid-line-rgb: 100, 100, 100">
              <div></div>
            </div>
            <div class="grids polygons">
              <div></div>
            </div>
            <div class="grids polygons">
              <div></div>
            </div>
            <div class="grids polygons">
              <div></div>
            </div>
          </div>
          <div class="wrapper">
            <div class="graphs polygons">
              <div><!-- Set 1 --></div>
            </div>
          </div>
        </div>
      
        <div class="labels-container">
          <div class="labels">
            {{localize "LP.Attributes.Agility"}}
            <input type="number" name="system.attributes.agility.current" value="{{system.attributes.agility.current}}"
              min="-2" max="2">
            <i class="fa-solid {{#if (lt system.attributes.agility.current 0)}}fa-down{{else}}fa-up{{/if}}"></i>
          </div>
      
          <div class="labels">
            {{localize "LP.Attributes.Cunning"}}
            <input type="number" name="system.attributes.cunning.current" value="{{system.attributes.cunning.current}}"
              min="-2" max="2">
            <i class="fa-solid {{#if (lt system.attributes.cunning.current 0)}}fa-down{{else}}fa-up{{/if}}"></i>
          </div>
      
        </div>
      
      </div>
    </div>
  </header>

  {{!-- Dream --}}
  <prose-mirror name="system.dream" data-document-u-u-i-d="{{ actor.uuid }}" value="{{ system.dream }}" toggled collaborate
    compact owner={{ user.isOwner }} editable={{ editable }} data-tooltip="{{localize "LP.Deviant.DreamTip"}}">
    {{{ system.dreamEnriched }}}
  </prose-mirror>

  {{!-- Info & Status Row --}}
  <div class="status flexrow gap-10">
    {{!-- Frame / Background / Experience --}}
    <div class="stat-box stat">
      {{!-- Frame --}}
      <div>
        <label>{{localize "LP.Deviant.Frame"}}</label>
  
        <input type="text" name="system.frame" value="{{system.frame}}">
      </div>
  
      {{!-- Background --}}
      <div>
        <label>{{localize "LP.Deviant.Background"}}</label>
  
        <input type="text" name="system.background" value="{{system.background}}">
      </div>
  
      {{!-- Experience --}}
      <div>
        <label>{{localize "LP.Resources.Experience"}}</label>
  
        <input type="number" name="system.experience" value="{{system.experience}}" min="0">
      </div>
    </div>
  
    {{!-- Advantage --}}
    <fieldset class="stat stat-box">
      <legend class="flexrow flex-group-left">
        {{localize "LP.Ups.Label"}}: {{numberFormat system.ups decimals=0 sign=true}}
      </legend>
  
      {{!-- Preparation --}}
      <div>{{localize "LP.Crew.Preparation"}}: {{ system.crewPreparation }}</div>
  
      {{!-- Scene Difficulty --}}
      <div>{{localize "LP.Scene.Complexity"}}: {{ system.sceneComplexity }}</div>
  
      {{!-- Advatange Hint --}}
      {{#if (gt system.ups 0)}}
      {{localize "LP.Ups.AdvantageHint"}}
      {{else if (lt system.ups 0)}}
      {{localize "LP.Ups.DisadvantageHint"}}
      {{/if}}
    </fieldset>
  
    {{!-- Impatience Clock --}}
    <div class="impatience stat">
      <label>{{localize "LP.Progress.Impatience"}}: {{system.impatience.value}}/{{system.impatience.max}}</label>

      {{> clock arr=impatience data=system.impatience}}
    </div>
  </div>

  {{!-- Lists --}}
  <div class="flexcol gap-10">
    {{!-- Skills --}}
    <fieldset class="stat stat-box">
      <legend class="flexrow flex-group-left">
        {{localize "LP.Skill.Plural"}}
  
        {{!-- Item Create Button --}}
        <a class="item-create ml-1" title="{{localize " LP.Skill.Create"}}" data-action="itemCreate" data-type="skill">
          <i class="fa-solid fa-square-plus"></i>
        </a>
      </legend>
  
      <ol class="item-list skills">
        {{#each skills as |item id|}}
        {{> itemSimple item=item id=id}}
        {{/each}}
      </ol>
    </fieldset>
  
    {{!-- Assets --}}
    <fieldset class="stat stat-box">
      <legend class="flexrow flex-group-left">
        {{localize "LP.Asset.Plural"}}
  
        {{!-- Item Create Button --}}
        <a class="item-create ml-1" title="{{localize " LP.Asset.Create"}}" data-action="itemCreate" data-type="asset">
          <i class="fa-solid fa-square-plus"></i>
        </a>
      </legend>
  
      <ol class="item-list assets">
        {{#each assets as |item id|}}
        {{> itemSimple item=item id=id}}
        {{/each}}
      </ol>
    </fieldset>
  </div>
  
  {{!-- Challenge/Connection Lists --}}
  <div class="flexrow gap-10">
    {{!-- Left Col --}}
    <div class="flexcol">
      {{!-- Challenges --}}
      <fieldset class="stat stat-box">
        <legend class="flexrow flex-group-left">
          {{localize "LP.Progress.Challenge.Plural"}}
  
          {{!-- Item Create Button --}}
          <a class="ml-1" title="{{localize " LP.Challenge.Create"}}" data-action="itemCreate" data-type="challenge">
            <i class="fa-solid fa-square-plus"></i>
          </a>
        </legend>
  
        <ol class="item-list challenges">
          {{#each challenges as |item id|}}
          {{> itemProgress item=item id=id}}
          {{/each}}
        </ol>
  
      </fieldset>
    </div>
  
    {{!-- Right Col --}}
    <div class="flexcol">
      {{!-- Connections --}}
      <fieldset class="stat stat-box">
        <legend class="flexrow flex-group-left">
          {{localize "LP.Connection.Plural"}}
  
          {{!-- Item Create Button --}}
          <a class="ml-1" title="{{localize " LP.Connection.Create"}}" data-action="itemCreate" data-type="connection">
            <i class="fa-solid fa-square-plus"></i>
          </a>
        </legend>
  
        <ol class="item-list connections">
          {{#each connections as |item id|}}
          {{> itemProgress item=item id=id}}
          {{/each}}
        </ol>
      </fieldset>
    </div>
  </div>
</section>