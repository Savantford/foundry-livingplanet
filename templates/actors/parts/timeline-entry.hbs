<li class="timeline-entry">
    <div class="cycle">#{{idx}}</div>
    <div class="expedition">{{#if entry.expedition}}{{entry.expedition}}{{else}}—{{/if}}</div>
    <div class="base-event">{{#if entry.baseEvent}}{{entry.baseEvent}}{{else}}—{{/if}}</div>
    <div class="local-event">{{#if entry.localEvent}}{{entry.localEvent}}{{else}}—{{/if}}</div>
    <div class="other"><input type="text" name="system.timeline.{{idx}}.other" value="{{entry.other}}"></div>
</li>