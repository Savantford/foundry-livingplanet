<div class="resources grid-2">

    <div class="statbox">{{!-- Left Column --}}
        <h3>{{localize "HotLP.Stats"}}</h3>

        <div class="stat">{{!-- Level, Ancestry --}}
            <label for="level" class="resource-label">{{localize "HotLP.Level"}}</label>
            {{system.stats.level}}

            <label class="ml-1" for="ancestry" class="resource-label">{{localize "HotLP.Ancestry"}}</label>
            {{system.details.ancestry}}
        </div>

        <div class="stat">{{!-- Type, Senses --}}
            {{#if system.details.type}}<label for="type" class="resource-label">{{localize
                "HotLP.Type"}}</label>
            {{system.details.type}}{{/if}}
        </div>

        {{#if system.details.professions}}
        <div class="stat">{{!-- Professions --}}
            <label class="" for="professions" class="resource-label">{{localize "HotLP.Professions"}}</label>
            {{system.details.professions}}
        </div>
        {{/if}}

        <div class="stat mt-1">{{!-- Paths --}}
            {{#if system.details.novice}}
            <label for="paths" class="resource-label">{{localize "HotLP.Paths"}}</label>
            <ol class="summary-list">
                <li title="{{localize " HotLP.NovicePath"}}">{{system.details.novice}}</li>
                {{#if system.details.expert}}<li title="{{localize " HotLP.ExpertPath"}}">
                    {{system.details.expert}}</li>{{/if}}
                {{#if system.details.expert}}<li title="{{localize " HotLP.MasterPath"}}">
                    {{system.details.master}}</li>{{/if}}
            </ol>
            {{/if}}
        </div>

        <div class="hl">
            <div class="stat mt-1">{{!-- Defense, Health, Damage --}}
                <label for="defense" class="resource-label">{{localize "HotLP.Defense.Title"}}</label>
                <a title="{{localize "HotLP.Defense.Natural"}}: {{system.stats.defense.natural}}">{{system.stats.defense.total}}</a>
                <label class="ml-1" for="health" class="resource-label">{{localize "HotLP.Health.Title"}}</label>

                <a class="health-edit" title="Edit Health">{{system.stats.health.total}}</a>
                <label class="ml-1" for="damage" class="resource-label">{{localize "HotLP.Damage.Title"}}</label>
                {{system.stats.damage.value}}
            </div>
            <div class="stat mt-1">{{!-- Attributes 1 --}}
                <label for="str" class="resource-label">{{localize "HotLP.Strength"}}</label>
                {{system.attributes.str.value}} ({{numberFormat system.attributes.str.mod decimals=0 sign=true}})

                <label class="ml-1" for="agi" class="resource-label">{{localize "HotLP.Agility"}}</label>
                {{system.attributes.agi.value}} ({{numberFormat system.attributes.agi.mod decimals=0 sign=true}})
            </div>
            <div class="stat">{{!-- Attributes 2 --}}
                <label for="int" class="resource-label">{{localize "HotLP.Intellect"}}</label>
                {{system.attributes.int.value}} ({{numberFormat system.attributes.int.mod decimals=0 sign=true}})

                <label class="ml-1" for="wil" class="resource-label">{{localize "HotLP.Will"}}</label>
                {{system.attributes.wil.value}} ({{numberFormat system.attributes.wil.mod decimals=0 sign=true}})
            </div>
        </div>

        <div class="stat">{{!-- Senses --}}
            {{#if system.details.senses}}<label for="senses" class="resource-label">{{localize
                "HotLP.Senses"}}</label>
            {{system.details.senses}}{{/if}}
        </div>

        <div class="stat">{{!-- Languages --}}
            <label class="" for="languages" class="resource-label">{{localize "HotLP.Languages"}}</label>
            {{system.details.languages}}
        </div>
        {{#if system.details.immune}}<div class="stat mt-1">{{!-- Immune --}}
            <label class="" for="immune" class="resource-label">{{localize "HotLP.Immune"}}</label>
            {{system.details.immune}}
        </div>{{/if}}
        <div class="stat mt-1">{{!-- Size, Speed --}}
            <label for="size" class="resource-label">{{localize "HotLP.Size"}}</label>
            {{system.stats.size}}

            <label class="ml-1" for="speed" class="resource-label">{{localize "HotLP.Speed"}}</label>
            {{system.stats.speed.value}}
            {{#if system.stats.speed.special}} ({{system.stats.speed.special}}){{/if}}
        </div>

        <h3 class="mt-2">{{localize "HotLP.Attacks"}}</h3>
        
        {{!-- Bonus Damage --}}
        {{#if system.stats.bonusdamage}}
        <div class="stat">
            <label class="" for="bonusdamage" class="resource-label">{{localize "HotLP.Damage.Bonus"}}</label>
            +{{system.stats.bonusdamage}}d6
        </div>
        {{/if}}

        {{!-- Weapons List --}}
        <div class="mt-1">
            <ol class="described-list">
                {{#each weapons as |item id|}}
                <li class="item" data-item-id="{{item._id}}">
                    <a class="rollable item-roll" title="Roll Attack">{{item.name}}</a>
                    <a class="item-edit" title="Edit Weapon"><i class="fas fa-edit"></i></a>
                    {{#if item.system.description.value}}<a class="item-scroll" data-tooltip="{{item.system.description.value}}"><i class="far fa-scroll"></i></a>{{/if}}
                    <a class="damage-roll" title="Roll Damage Dice"><i class="fas fa-burst"></i></a>
                    {{#if item.system.reload}}<input class="checkbox-reloaded" type="checkbox" name="item.system.reloaded" title="Weapon realoded?" {{checked item.system.reloaded}}/>{{/if}} 
                    ({{item.system.grip}}{{#if item.system.properties}};
                    {{item.system.properties}}{{/if}}) 

                    {{item.system.attributeLabel}}
                    {{#if item.system.boons}} {{localize "HotLP.Boons.With"}} {{item.system.boons}} 
                        {{#if (lt item.system.boons -1)}}{{localize "HotLP.Boons.Banes"}}
                            {{else if (lt item.system.boons 0)}}{{localize "HotLP.Boons.Bane"}}
                            {{else if (gt item.system.boons 1)}}{{localize "HotLP.Boons.Boons"}}
                            {{else}}{{localize "HotLP.Boons.Boon"}}
                        {{/if}}
                    {{/if}}
                    ({{item.system.damage}})
                </li>
                {{/each}}
            </ol>
        </div>
    </div>

    <div class="statbox">{{!-- Right Column --}}
        <h3>{{localize "HotLP.Talents"}}</h3>
        <ol class="compact-list stat">
            {{#each talents as |item id|}}
            <li class="item" data-item-id="{{item._id}}">
                {{#if item.system.attribute}}<a class="rollable item-roll" title="Roll Talent">{{item.name}}</a>
                    {{else}}<label>{{item.name}}</label>{{/if}}
                <a class="item-edit" title="Edit Talent"><i class="fas fa-edit"></i></a>
                {{#if item.system.description.value}}<a class="item-scroll" data-tooltip="{{item.system.description.value}}"><i class="far fa-scroll"></i></a>{{/if}}
                {{#if item.system.damage}}<a class="damage-roll" title="Roll Damage Dice"><i class="fas fa-burst"></i></a>{{/if}}
                {{#if item.system.healing}}<a class="healing-roll" title="Roll Healing Dice"><i class="fas fa-sparkles"></i></a>{{/if}}
                {{#if item.uses}}
                    <span class="pip-box">
                        {{#each item.uses as |pip id|}}
                        <a class="item-pip" title="{{#if (eq pip "far")}}Spend use/token{{else}}Recover use/token{{/if}}"><i
                                class="{{pip}} fa-circle"></i></a>
                        {{/each}}
                    </span>
                {{/if}}
            </li>
            {{/each}}
        </ol>

        {{#if system.details.traditions}}
        <h3 class="mt-2">{{localize "HotLP.Spells"}}</h3>

        {{!-- Traditions --}}
        <div class="stat mb-2">
            <label class="" for="traditions" class="resource-label">{{localize "HotLP.Traditions"}}</label>
            {{system.details.traditions}}
        </div>

        <ol class="compact-list stat">
            {{#each spells as |item id|}}
            <li class="item" data-item-id="{{item._id}}">
                {{#if item.system.attribute}}<a class="rollable item-roll" title="Roll Spell">{{item.name}}</a>
                    {{else}}<label>{{item.name}}</label>{{/if}}
                <a class="item-edit" title="Edit Spell"><i class="fas fa-edit"></i></a>
                {{#if item.system.description.value}}<a class="item-scroll" data-tooltip="{{item.system.description.value}}"><i class="far fa-scroll"></i></a>{{/if}}
                {{#if item.system.damage}}<a class="damage-roll" title="Roll Damage Dice"><i class="fas fa-burst"></i></a>{{/if}}
                {{#if item.system.healing}}<a class="healing-roll" title="Roll Healing Dice"><i class="fas fa-sparkles"></i></a>{{/if}}
                {{#if item.uses}}
                    <span class="pip-box">
                        {{#each item.uses as |pip id|}}
                        <a class="item-pip" title="{{#if (eq pip "far")}}Spend casting{{else}}Recover casting{{/if}}"><i
                                class="{{pip}} fa-circle"></i></a>
                        {{/each}}
                    </span>
                {{/if}}
            </li>
            {{/each}}
        </ol>
        {{/if}}
    </div>
</div>